<?xml version="1.0" encoding="utf-8"?>
<!-- Icono adaptable: el navy de la marca como fondo y la luna dorada como
     capa delantera, para que el sistema pueda recortarlo con la forma que
     use cada lanzador sin comerse el dibujo. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/fondo_icono" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
