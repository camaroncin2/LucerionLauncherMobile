<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Avisos de progreso de descargas/instalación y evitar que Android
         corte el juego en segundo plano. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- El instalador de NeoForge ejecuta sus procesadores en una JVM aparte
         (servicio :jvm en primer plano). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:glEsVersion="0x00020000" />

    <application
        android:name=".AplicacionLucerion"
        android:allowNativeHeapPointerTagging="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Lucerion"
        android:largeHeap="true"
        tools:targetApi="31"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: el backend de modpacks sirve por HTTP plano
             (IP:3100) hasta que tenga dominio con TLS. Quitarlo cuando exista. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Superficie del juego: apaisada, inmersiva, proceso principal. -->
        <activity
            android:name=".ui.juego.JuegoActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation"
            android:launchMode="singleTask" />

        <!-- Editor de controles con previsualizacion (Ajustes -> Controles). -->
        <activity
            android:name=".ui.juego.EditorControlesActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard" />

        <!-- Primer plano durante la partida: sin el, Android mata el proceso
             (y la JVM del juego con el) a los segundos de minimizar. -->
        <service
            android:name=".motor.ServicioJuego"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- JVM del instalador (procesadores de NeoForge/Forge). FCLCore no
             declara manifest propio: cada consumidor del motor lo hace. -->
        <service
            android:name="com.tungsten.fclcore.download.ProcessService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":jvm" />

        <!-- El motor abre enlaces/archivos con la autoridad ${applicationId}.provider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
    </application>
</manifest>
